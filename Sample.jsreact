import React, { useState, useEffect, useCallback, useRef } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, collection, addDoc, query, getDocs, doc, setDoc } from 'firebase/firestore';
import { Loader2, Zap, Brain, TrendingUp, Sun, Moon, Utensils, Smile, Sliders, Settings, MessageSquareText, Send, Droplet, Clock } from 'lucide-react';

// --- Global Firebase Variables (Mandatory Canvas Environment Setup) ---
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
const API_URL_GEMINI = "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=";
const API_KEY = "" // API key is handled by the Canvas environment.

// --- COLOR AND AVATAR MAPPING ---
// Maps avatar style to a Tailwind color (e.g., 'indigo-600')
const AVATAR_COLOR_MAP = {
    'Zap': { color: 'indigo', name: 'Focus', shade: 600 },
    'Sun': { color: 'amber', name: 'Clarity', shade: 600 },
    'Moon': { color: 'slate', name: 'Stability', shade: 600 }, // Closest to Taupe/Warm Gray
    'Brain': { color: 'emerald', name: 'Tranquility', shade: 600 }, // Closest to Sage Green
};

// Helper function to simulate array sorting
const sortByTimestamp = (a, b) => new Date(b.timestamp) - new Date(a.timestamp);

// Utility function for exponential backoff during API calls
const fetchWithRetry = async (url, options, retries = 3) => {
  for (let i = 0; i < retries; i++) {
    try {
      const response = await fetch(url, options);
      if (response.status === 429) { // Too Many Requests
        const delay = Math.pow(2, i) * 1000 + Math.random() * 1000;
        console.warn(`Rate limit exceeded. Retrying in ${delay / 1000}s...`);
        await new Promise(resolve => setTimeout(resolve, delay));
        continue;
      }
      return response;
    } catch (error) {
      if (i === retries - 1) throw error;
      const delay = Math.pow(2, i) * 1000 + Math.random() * 1000;
      console.error(`Fetch failed. Retrying in ${delay / 1000}s...`);
      await new Promise(resolve => setTimeout(resolve, delay));
    }
  }
};


// --- FIREBASE INITIALIZATION AND HOOKS ---
const useFirebase = () => {
    const [db, setDb] = useState(null);
    const [auth, setAuth] = useState(null);
    const [userId, setUserId] = useState(null);

    useEffect(() => {
        if (Object.keys(firebaseConfig).length === 0) return;

        try {
            const app = initializeApp(firebaseConfig);
            const firestore = getFirestore(app);
            const authentication = getAuth(app);

            setDb(firestore);
            setAuth(authentication);

            const unsubscribe = onAuthStateChanged(authentication, (user) => {
                if (user) {
                    setUserId(user.uid);
                } else {
                    const authenticate = async () => {
                        try {
                            if (initialAuthToken) {
                                await signInWithCustomToken(authentication, initialAuthToken);
                            } else {
                                await signInAnonymously(authentication);
                            }
                        } catch (error) {
                            console.error("Firebase authentication failed:", error);
                        }
                    };
                    authenticate();
                }
            });

            return () => unsubscribe();
        } catch (e) {
            console.error("Error initializing Firebase:", e);
        }
    }, []);

    return { db, auth, userId };
};

// --- APP COMPONENT ---
const App = () => {
    const { db, userId } = useFirebase();
    const [isLoading, setIsLoading] = useState(false);
    const [logs, setLogs] = useState([]);
    const [sparkyMessage, setSparkyMessage] = useState("Authenticating...");
    
    // NEW TAB: 'focus' added to the list
    const [activeTab, setActiveTab] = useState('focus'); 
    const [isDarkMode, setIsDarkMode] = useState(false); 
    
    // State needed for button selection (kept in App)
    const [mood, setMood] = useState('neutral');
    const [quality, setQuality] = useState('medium');
    const [mealType, setMealType] = useState('lunch');
    const [activityType, setActivityType] = useState('Workout');


    // Companion Configuration
    const [companionName, setCompanionName] = useState('Aura');
    const [avatarStyle, setAvatarStyle] = useState('Brain'); // Set to 'Brain' for user's preference
    // NEW STATE: Primary color is derived from the avatarStyle mapping
    const [primaryColor, setPrimaryColor] = useState(AVATAR_COLOR_MAP['Brain'].color);

    // Reply Box State
    const [userReply, setUserReply] = useState('');
    const [replyStatus, setReplyStatus] = useState(null); 


    const LOG_COLLECTION_PATH = `/artifacts/${appId}/users/${userId}/health_logs`;
    const CONFIG_DOC_PATH = `/artifacts/${appId}/users/${userId}/companion_config`;

    // --- CONFIG & DATA FETCHING ---

    const fetchConfig = useCallback(async () => {
        if (!db || !userId) return;
        try {
            const configRef = doc(db, CONFIG_DOC_PATH, 'settings'); 
            const configSnap = await getDocs(query(collection(db, CONFIG_DOC_PATH)));
            
            if (!configSnap.empty) {
                const data = configSnap.docs[0].data();
                const name = data.name || 'Aura';
                const avatar = data.avatar || 'Brain';
                setCompanionName(name);
                setAvatarStyle(avatar);
                // Update primary color based on fetched avatar
                const colorConfig = AVATAR_COLOR_MAP[avatar] || AVATAR_COLOR_MAP['Brain'];
                setPrimaryColor(colorConfig.color);

                setSparkyMessage(`Welcome back. I am ${name}, your personal analyst. Log your data to maintain peak efficiency.`);
            } else {
                 // Save the default 'Brain' setting for the user's preference
                 await handleSaveConfig('Brain', AVATAR_COLOR_MAP['Brain'].color, 'Aura');
                 setSparkyMessage(`Welcome. Use the Companion tab to set up your AI Companion.`);
            }
        } catch (e) {
            console.error("Error fetching config:", e);
        }
    }, [db, userId, CONFIG_DOC_PATH]);
    
    // Updated save config function to handle name change
    const handleSaveConfig = async (newAvatarStyle, newPrimaryColor, newName = companionName) => {
        if (!db || !userId) return;
        try {
            const configRef = doc(db, CONFIG_DOC_PATH, 'settings'); 
            await setDoc(configRef, { name: newName, avatar: newAvatarStyle }, { merge: true });
            setCompanionName(newName);
            setAvatarStyle(newAvatarStyle);
            setPrimaryColor(newPrimaryColor);
            setSparkyMessage(`${newName} is now active with the ${newAvatarStyle} profile. Settings saved!`);
        } catch (e) {
            console.error("Error saving config:", e);
        }
    };


    const fetchLogs = useCallback(async () => {
        if (!db || !userId) return;

        try {
            const q = query(collection(db, LOG_COLLECTION_PATH));
            const querySnapshot = await getDocs(q);
            const fetchedLogs = querySnapshot.docs.map(doc => ({
                id: doc.id,
                ...doc.data(),
                timestamp: doc.data().timestamp, // Ensure timestamp is accessible
            }));
            setLogs(fetchedLogs.sort(sortByTimestamp));
        } catch (e) {
            console.error("Error fetching documents: ", e);
        }
    }, [db, userId, LOG_COLLECTION_PATH]);

    useEffect(() => {
        if (userId && db) {
            fetchConfig();
            fetchLogs();
        }
    }, [userId, db, fetchConfig, fetchLogs]);

    // --- PATTERN DETECTION LOGIC (Updated to include 'focus' logs) ---
    const detectPattern = (currentLogs = logs) => {
        if (currentLogs.length < 10) return "Gathering baseline data for macro-trend analysis (requires 10+ logs).";
        
        const recentLogs = currentLogs.slice(0, 10);
        let highFocusAfterHighSleep = 0;
        let stressAfterLowFocus = 0;
        let recentSleep = null;
        let recentFocus = null;

        for (const log of recentLogs) {
             if (log.type === 'sleep') {
                recentSleep = log;
            } else if (log.type === 'focus') {
                recentFocus = log;
                if (log.status === 'completed' && recentSleep && recentSleep.quality === 'high') {
                    highFocusAfterHighSleep++;
                }
            } else if (log.type === 'mood' && log.mood === 'stressed' && recentFocus) {
                const timeDiff = new Date(log.timestamp).getTime() - new Date(recentFocus.timestamp).getTime();
                if (recentFocus.status === 'interrupted' && timeDiff > 0 && timeDiff < 8 * 60 * 60 * 1000) {
                    stressAfterLowFocus++;
                }
            }
        }

        if (highFocusAfterHighSleep >= 2) {
            return `A critical trend: **High quality sleep is directly correlating with Focus Block completion**. Maintain sleep discipline.`;
        }
        if (stressAfterLowFocus >= 2) {
            return `Negative trend: **Interrupted Focus Blocks often lead to subsequent stress spikes**. Focus on eliminating distractions during work periods.`;
        }

        return "Data is stable. No critical correlation detected in your recent logs. Focus on maintaining consistency.";
    };

    // Helper to get system prompt based on context
    const getSystemPrompt = (type) => {
        const base = `Act as ${companionName}, the Overlord's dedicated **Efficiency Analyst**. Your core mission is to maximize performance and stamina. Your response must be concise and use **simple, direct, everyday language**. Avoid jargon, complex vocabulary, and overly formal phrasing. Start your response with "${companionName}:". Do not use emojis.`;
        
        if (type === 'log') {
            return base + `Your response must consist of EXACTLY TWO SENTENCES: 1. (Advice): Give a single, clear, and immediate recommendation based on the current log data. 2. (Offer): Always acknowledge that implementing the advice can be challenging and offer specific, actionable follow-up assistance.`;
        } else if (type === 'reply') {
            return base + `Your response must be a single, conversational paragraph (max 3 sentences) that directly answers the user's question, referencing the last insight to maintain context. Since the user initiated this reply, make your advice actionable and friendly.`;
        }
        return base;
    }


    // --- GEMINI API CALL FOR ADAPTIVE COACHING ---
    const generateAnalysis = useCallback(async (userQuery, promptType) => {
        // Set loading state ON for the duration of the API call
        setIsLoading(true);
        setSparkyMessage(`${companionName} is calculating optimal strategy...`);

        const systemPrompt = getSystemPrompt(promptType);

        const payload = {
            contents: [{ parts: [{ text: userQuery }] }],
            systemInstruction: { parts: [{ text: systemPrompt }] },
            tools: [{ "google_search": {} }],
        };

        try {
            const response = await fetchWithRetry(API_URL_GEMINI + API_KEY, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const result = await response.json();
            const textCandidate = result.candidates?.[0]?.content?.parts?.[0]?.text;

            let responseText;
            if (textCandidate) {
                // SUCCESS: Valid response received
                responseText = textCandidate;
            } else {
                // FAILURE: API succeeded but returned an empty/malformed response structure
                console.error("Gemini API returned an empty or malformed response structure.", result);
                responseText = `${companionName}: Analysis core received an empty transmission. Data loss suspected. Please try your action again.`;
            }

            setSparkyMessage(responseText);

        } catch (error) {
            // FAILURE: Network or catastrophic failure
            console.error("Gemini API call failed:", error);
            setSparkyMessage(`${companionName}: System failure. Cannot reach the analysis core. Please check your connection.`);
        } finally {
            // CRITICAL FIX: Ensure loading state is turned OFF after the fetch attempt completes.
            setIsLoading(false); 
        }
    }, [companionName]);

    // --- DATA SUBMISSION ---
    const handleSubmit = useCallback(async (newLog, logText) => {
        if (!db || !userId || isLoading) return;
        setIsLoading(true); // Set loading ON for data operations

        try {
            // Get the last log for context before adding the new one
            const lastLog = logs.length > 0 ? logs[0] : { type: 'system', content: 'No prior logs.' };
            
            // Format the last log's details for the AI prompt
            let contextString = `Previous Log (${lastLog.type}): `;
            if (lastLog.type === 'mood') contextString += `Mood: ${lastLog.mood}, Trigger: ${lastLog.trigger}`;
            else if (lastLog.type === 'sleep') contextString += `Hours: ${lastLog.hours}, Quality: ${lastLog.quality}`;
            else if (lastLog.type === 'food') contextString += `Meal Type: ${lastLog.mealType}, Content: ${lastLog.content}`;
            else if (lastLog.type === 'activity') contextString += `Activity: ${lastLog.activity}, Duration: ${lastLog.duration} min, Hydration: ${lastLog.hydration} units.`;
            else if (lastLog.type === 'focus') contextString += `Duration: ${lastLog.duration} min, Status: ${lastLog.status}, Task: ${lastLog.task}`;
            else contextString += lastLog.content; // Use for 'system' or unexpected logs
            
            // Add the new log to Firestore
            await addDoc(collection(db, LOG_COLLECTION_PATH), newLog);

            // Fetch the very latest logs (including the new one)
            const q = query(collection(db, LOG_COLLECTION_PATH));
            const querySnapshot = await getDocs(q);
            const latestLogs = querySnapshot.docs.map(doc => ({
                id: doc.id,
                ...doc.data(),
                timestamp: doc.data().timestamp, 
            })).sort(sortByTimestamp);
            
            setLogs(latestLogs); // Update global state
            
            // Generate the specific analysis response (promptType: 'log')
            const logAnalysisQuery = `Analyze this new log: "${logText}". Immediate contextual history: "${contextString}". Generate the two-sentence analysis and tip.`;
            
            // generateAnalysis handles its own loading state cleanup now.
            await generateAnalysis(logAnalysisQuery, 'log'); 

        } catch (e) {
            console.error("Error adding document: ", e);
            setSparkyMessage(`${companionName}: Database write error. Log failed.`);
            setIsLoading(false); // Ensure loading is off if DB write fails before API call
        } 
    }, [db, userId, isLoading, companionName, generateAnalysis, logs]); 

    // --- LOCAL REPLY HANDLER ---
    const handleLocalReply = () => {
        if (!userReply.trim() || isLoading) return;

        const replyText = userReply.trim();
        setUserReply(''); // Clear input immediately
        
        // Prepare context for the AI reply
        const currentInsight = sparkyMessage.replace(`${companionName}: `, '').trim();
        const replyQuery = `The user's previous context was: "${currentInsight}". The user has replied with: "${replyText}". Directly answer the user's question or respond to their statement in a single conversational paragraph.`;
        
        // Call the analysis function with the 'reply' prompt type.
        // The generateAnalysis function now correctly manages the isLoading state.
        generateAnalysis(replyQuery, 'reply');
        
        // Use replyStatus for the *user* input to show it was accepted
        setReplyStatus({ message: `Reply sent: **${replyText}**. Awaiting ${companionName}'s response...`, type: 'success' });
        
        // Clear status after 5 seconds
        setTimeout(() => setReplyStatus(null), 5000);
    };


    // --- UI HELPERS ---
    const getAvatar = (style) => {
        const config = AVATAR_COLOR_MAP[style];
        const colorClass = `text-${config.color}-500`;

        switch (style) {
            case 'Sun': return <Sun className={colorClass} size={48} />;
            case 'Moon': return <Moon className={colorClass} size={48} />;
            case 'Brain': return <Brain className={colorClass} size={48} />;
            case 'Zap':
            default: return <Zap className={colorClass} size={48} />;
        }
    };
    
    // --- Utility to get dynamic Tailwind classes ---
    const getAccentClass = (shade = 600, prefix = 'text') => {
        return `${prefix}-${primaryColor}-${shade}`;
    };

    // --- SUB-COMPONENTS (State management retained) ---

    // NEW: Focus Timer Component
    const FocusTimer = ({ isLoading, handleSubmit }) => {
        const [minutes, setMinutes] = useState(25);
        const [seconds, setSeconds] = useState(0);
        const [isRunning, setIsRunning] = useState(false);
        const [isBreak, setIsBreak] = useState(false);
        const [task, setTask] = useState('');
        const [initialDuration, setInitialDuration] = useState(25);
        const timerRef = useRef(null);

        const accentClass = getAccentClass(600, 'bg');
        const accentHoverClass = getAccentClass(700, 'bg');
        const accentRingClass = getAccentClass(500, 'focus:ring');
        const accentBorderClass = getAccentClass(500, 'focus:border');
        
        const formatTime = (m, s) => `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;

        const startTimer = () => {
            if (isRunning) return;
            if (!task.trim()) { setTask('Unnamed Focus Block'); }
            setIsRunning(true);
            setInitialDuration(minutes); // Record initial time for logging
        };

        const stopTimer = (status) => {
            if (!isRunning) return;
            setIsRunning(false);
            
            // Log the result
            const duration = initialDuration - minutes;
            const finalStatus = status === 'completed' ? 'completed' : 'interrupted';

            const newLog = { 
                type: 'focus', 
                timestamp: new Date().toISOString(), 
                duration, 
                status: finalStatus, 
                task: task.trim() || 'Unnamed Focus Block'
            };
            
            const logText = `Focus Block: ${task.trim() || 'Unnamed Focus Block'} was ${finalStatus} after ${duration} minutes.`;
            handleSubmit(newLog, logText);

            // Reset for next session
            setMinutes(25);
            setSeconds(0);
            setIsBreak(false);
            setTask('');
        };
        
        const resetTimer = () => {
             if (isRunning) stopTimer('interrupted');
             setMinutes(25);
             setSeconds(0);
             setIsBreak(false);
             setIsRunning(false);
             setTask('');
        }

        useEffect(() => {
            if (!isRunning) {
                if (timerRef.current) clearInterval(timerRef.current);
                return;
            }

            timerRef.current = setInterval(() => {
                setSeconds(prevSeconds => {
                    if (prevSeconds === 0) {
                        setMinutes(prevMinutes => {
                            if (prevMinutes === 0) {
                                // Time is up!
                                if (isBreak) {
                                    // Break finished, start next focus
                                    setIsBreak(false);
                                    setMinutes(25); 
                                    setSeconds(0);
                                    // Don't auto-start focus, wait for user input or manual log
                                    setIsRunning(false);
                                } else {
                                    // Focus finished, log completion, start break
                                    stopTimer('completed');
                                    setIsBreak(true);
                                    setMinutes(5); // Default 5 minute break
                                    // Keep running for the break timer
                                    setIsRunning(true);
                                }
                                return 0;
                            }
                            return prevMinutes - 1;
                        });
                        return 59;
                    }
                    return prevSeconds - 1;
                });
            }, 1000);

            return () => clearInterval(timerRef.current);
        }, [isRunning, isBreak, initialDuration, task]);
        
        // Touch/Range slider handling for setting time
        const handleTimeChange = (e) => {
            if (!isRunning) {
                setMinutes(parseInt(e.target.value));
            }
        };


        return (
            <div className="space-y-6 text-center">
                <p className={`text-lg font-medium ${isBreak ? 'text-red-500' : 'text-gray-700 dark:text-gray-300'}`}>
                    {isBreak ? 'Short Break' : 'Focus Block'}
                </p>
                <div className="relative p-6">
                    <h1 className={`text-7xl font-mono font-extrabold ${getAccentClass(700, 'text')} dark:${getAccentClass(400, 'text')}`}>
                        {formatTime(minutes, seconds)}
                    </h1>
                </div>

                <div className="space-y-4">
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Current Task</label>
                    <input
                        type="text"
                        value={task}
                        onChange={(e) => setTask(e.target.value)}
                        placeholder="What are you working on?"
                        className={`w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:ring-4 ${accentRingClass} ${accentBorderClass}`}
                        disabled={isRunning || isLoading}
                    />
                </div>
                
                {!isRunning && (
                    <div className="space-y-2">
                        <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Set Focus Duration: {minutes} min</label>
                         <div className="py-2">
                            <input
                                type="range"
                                min="5"
                                max="60"
                                step="5"
                                value={minutes}
                                onChange={handleTimeChange}
                                className={`w-full h-3 bg-gray-300 dark:bg-gray-600 rounded-lg appearance-none cursor-pointer focus:outline-none focus:ring-2 ${accentRingClass}`} 
                                disabled={isRunning || isLoading}
                            />
                        </div>
                    </div>
                )}


                <div className="flex space-x-4 pt-4">
                    {!isRunning ? (
                        <button
                            onClick={startTimer}
                            disabled={isLoading || !minutes || isBreak}
                            className={`flex-1 ${accentClass} text-white font-bold py-3 rounded-xl hover:${accentHoverClass} transition duration-300 disabled:bg-gray-400 flex items-center justify-center`}
                        >
                            <Clock size={20} className="mr-2"/> Start Focus
                        </button>
                    ) : (
                         <>
                            <button
                                onClick={() => stopTimer('interrupted')}
                                disabled={isLoading || isBreak}
                                className={`flex-1 bg-red-600 text-white font-bold py-3 rounded-xl hover:bg-red-700 transition duration-300 disabled:bg-gray-400`}
                            >
                                Interrupt & Log
                            </button>
                            <button
                                onClick={resetTimer}
                                disabled={isLoading}
                                className={`w-1/4 bg-gray-200 text-gray-700 dark:bg-gray-600 dark:text-gray-300 font-bold py-3 rounded-xl hover:bg-gray-300 transition duration-300 disabled:bg-gray-400`}
                            >
                                Reset
                            </button>
                        </>
                    )}
                </div>
                {isBreak && <p className="text-sm text-gray-500 dark:text-gray-400">Time to recover. Log your next Focus Block when ready.</p>}
            </div>
        );
    };

    const LogMood = ({ currentMood, setMood, isLoading, handleSubmit }) => {
        // State moved locally
        const [trigger, setTrigger] = useState('');
        const accentClass = getAccentClass(500, 'border');
        const accentBgClass = getAccentClass(50, 'bg');
        const accentRingClass = getAccentClass(200, 'ring');

        const handleLog = () => {
            if (!trigger) { return; }
            const newLog = { type: 'mood', timestamp: new Date().toISOString(), mood: currentMood, trigger };
            const logText = `Mood: ${currentMood} (Trigger: ${trigger})`;
            handleSubmit(newLog, logText);
            setTrigger(''); // Clear local input state after submit
        };

        return (
            <div className="space-y-4">
                <div className="flex justify-around space-x-2">
                    {['happy', 'neutral', 'stressed'].map((m) => (
                        <button
                            key={m}
                            onClick={() => setMood(m)}
                            className={`flex-1 p-3 rounded-xl transition-all duration-200 border-2 ${
                                currentMood === m
                                    ? `${accentClass} ${accentBgClass} dark:${getAccentClass(900, 'bg')} ring-4 ${accentRingClass}`
                                    : 'border-gray-200 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700'
                            }`}
                        >
                            <span className="text-sm capitalize dark:text-gray-100">{m}</span>
                        </button>
                    ))}
                </div>

                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Trigger/Context (e.g., Deadline, Good Meeting)</label>
                <input
                    type="text"
                    value={trigger}
                    onChange={(e) => setTrigger(e.target.value)}
                    placeholder="What caused this feeling?"
                    className={`w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:ring-4 ${getAccentClass(500, 'focus:ring')} ${getAccentClass(500, 'focus:border')}`}
                    disabled={isLoading}
                />
                <button
                    onClick={handleLog}
                    disabled={isLoading || !trigger}
                    className={`w-full ${getAccentClass(600, 'bg')} text-white font-bold py-3 rounded-xl hover:${getAccentClass(700, 'bg')} transition duration-300 disabled:bg-gray-400`}
                >
                    Log Mood
                </button>
            </div>
        );
    };

    const LogSleep = ({ currentQuality, setQuality, isLoading, handleSubmit }) => {
         // State moved locally
        const [hours, setHours] = useState(7.5);
        const accentClass = getAccentClass(500, 'border');
        const accentBgClass = getAccentClass(50, 'bg');
        const accentRingClass = getAccentClass(200, 'ring');
        const accentRangeFocus = getAccentClass(500, 'focus:ring');

        const handleLog = () => {
            const newLog = { type: 'sleep', timestamp: new Date().toISOString(), hours: parseFloat(hours), quality: currentQuality };
            const logText = `Sleep: ${hours} hours (${currentQuality} quality)`;
            handleSubmit(newLog, logText);
        };

        return (
            <div className="space-y-4">
                 <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Hours Slept: {hours} hr</label>
                 <div className="py-2"> {/* Added vertical padding for touch target comfort */}
                    <input
                        type="range"
                        min="3"
                        max="12"
                        step="0.5"
                        value={hours}
                        onChange={(e) => setHours(e.target.value)}
                        className={`w-full h-3 bg-gray-300 dark:bg-gray-600 rounded-lg appearance-none cursor-pointer focus:outline-none focus:ring-2 ${accentRangeFocus}`} 
                        disabled={isLoading}
                    />
                 </div>

                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Quality of Sleep</label>
                <div className="flex justify-around space-x-2">
                    {['low', 'medium', 'high'].map((q) => (
                        <button
                            key={q}
                            onClick={() => setQuality(q)}
                            className={`flex-1 p-3 rounded-xl transition-all duration-200 border-2 capitalize ${
                                currentQuality === q
                                    ? `${accentClass} ${accentBgClass} dark:${getAccentClass(900, 'bg')} ring-4 ${accentRingClass}`
                                    : 'border-gray-200 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700'
                            }`}
                        >
                            <span className="dark:text-gray-100">{q}</span>
                        </button>
                    ))}
                </div>
                <button
                    onClick={handleLog}
                    disabled={isLoading}
                    className={`w-full ${getAccentClass(600, 'bg')} text-white font-bold py-3 rounded-xl hover:${getAccentClass(700, 'bg')} transition duration-300 disabled:bg-gray-400`}
                >
                    Log Sleep
                </button>
            </div>
        );
    };

    const LogFood = ({ currentMealType, setMealType, isLoading, handleSubmit }) => {
        // State moved locally
        const [content, setContent] = useState('');
        const accentClass = getAccentClass(500, 'border');
        const accentBgClass = getAccentClass(50, 'bg');
        const accentRingClass = getAccentClass(200, 'ring');

        const handleLog = () => {
             if (!content) { return; }
            const newLog = { type: 'food', timestamp: new Date().toISOString(), mealType: currentMealType, content };
            const logText = `Food: ${currentMealType} (${content})`;
            handleSubmit(newLog, logText);
            setContent(''); // Clear local input state after submit
        };

        return (
            <div className="space-y-4">
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Meal Type</label>
                <div className="flex justify-around space-x-2">
                    {['breakfast', 'lunch', 'dinner', 'snack'].map((m) => (
                        <button
                            key={m}
                            onClick={() => setMealType(m)}
                            className={`flex-1 p-3 rounded-xl transition-all duration-200 border-2 capitalize ${
                                currentMealType === m
                                    ? `${accentClass} ${accentBgClass} dark:${getAccentClass(900, 'bg')} ring-4 ${accentRingClass}`
                                    : 'border-gray-200 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700'
                            }`}
                        >
                            <span className="dark:text-gray-100">{m}</span>
                        </button>
                    ))}
                </div>

                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Meal Content/Impact</label>
                <textarea
                    value={content}
                    onChange={(e) => setContent(e.target.value)}
                    placeholder="What did you eat and how did you feel (e.g., healthy salad, felt energetic; heavy processed meal, felt sluggish)?"
                    rows="3"
                    className={`w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:ring-4 ${getAccentClass(500, 'focus:ring')} ${getAccentClass(500, 'focus:border')}`}
                    disabled={isLoading}
                />
                <button
                    onClick={handleLog}
                    disabled={isLoading || !content}
                    className={`w-full ${getAccentClass(600, 'bg')} text-white font-bold py-3 rounded-xl hover:${getAccentClass(700, 'bg')} transition duration-300 disabled:bg-gray-400`}
                >
                    Log Food
                </button>
            </div>
        );
    };

    const LogActivity = ({ currentActivityType, setActivityType, isLoading, handleSubmit }) => {
        const [duration, setDuration] = useState(30); // in minutes
        const [hydration, setHydration] = useState(0); // in ounces (approximation)

        const accentClass = getAccentClass(500, 'border');
        const accentBgClass = getAccentClass(50, 'bg');
        const accentRingClass = getAccentClass(200, 'ring');
        const accentRangeFocus = getAccentClass(500, 'focus:ring');
        const accentIconClass = getAccentClass(500, 'text');

        const handleLog = () => {
            const newLog = { 
                type: 'activity', 
                timestamp: new Date().toISOString(), 
                activity: currentActivityType, 
                duration: parseInt(duration), 
                hydration: parseInt(hydration) 
            };
            const logText = `Activity: ${currentActivityType} for ${duration} minutes, Hydration: ${hydration} ounces.`;
            handleSubmit(newLog, logText);
        };

        return (
            <div className="space-y-6">
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Activity Type</label>
                <div className="flex justify-around space-x-2">
                    {['Workout', 'Walk', 'Meditation', 'Hobby'].map((a) => (
                        <button
                            key={a}
                            onClick={() => setActivityType(a)}
                            className={`flex-1 p-3 rounded-xl transition-all duration-200 border-2 ${
                                currentActivityType === a
                                    ? `${accentClass} ${accentBgClass} dark:${getAccentClass(900, 'bg')} ring-4 ${accentRingClass}`
                                    : 'border-gray-200 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700'
                            }`}
                        >
                            <span className="text-sm dark:text-gray-100">{a}</span>
                        </button>
                    ))}
                </div>

                <div className="space-y-2">
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Duration: {duration} min</label>
                    <div className="py-2">
                         <input
                            type="range"
                            min="5"
                            max="180"
                            step="5"
                            value={duration}
                            onChange={(e) => setDuration(e.target.value)}
                            className={`w-full h-3 bg-gray-300 dark:bg-gray-600 rounded-lg appearance-none cursor-pointer focus:outline-none focus:ring-2 ${accentRangeFocus}`}
                            disabled={isLoading}
                        />
                    </div>
                </div>

                <div className="space-y-2">
                    <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 flex items-center">
                        <Droplet size={16} className={`${accentIconClass} mr-1`} />
                        Hydration (oz): {hydration} oz
                    </label>
                    <input
                        type="number"
                        min="0"
                        max="100"
                        step="8"
                        value={hydration}
                        onChange={(e) => setHydration(e.target.value)}
                        placeholder="e.g., 32"
                        className={`w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:ring-4 ${getAccentClass(500, 'focus:ring')} ${getAccentClass(500, 'focus:border')}`}
                        disabled={isLoading}
                    />
                </div>
                
                <button
                    onClick={handleLog}
                    disabled={isLoading || duration < 5}
                    className={`w-full ${getAccentClass(600, 'bg')} text-white font-bold py-3 rounded-xl hover:${getAccentClass(700, 'bg')} transition duration-300 disabled:bg-gray-400`}
                >
                    Log Activity & Hydration
                </button>
            </div>
        );
    };

    const SettingsTab = ({ companionName, setCompanionName, avatarStyle, handleSaveConfig, getAvatar, getAccentClass, primaryColor }) => {
        // Local state for name input
        const [localName, setLocalName] = useState(companionName);
        
        // Function to handle name saving
        const handleNameSave = () => {
            if (localName.trim() !== companionName) {
                 const config = AVATAR_COLOR_MAP[avatarStyle];
                 handleSaveConfig(avatarStyle, config.color, localName.trim());
            }
        };

        return (
            <div className="space-y-6">
                <h3 className="text-lg font-semibold text-gray-800 dark:text-gray-100">Companion Customization</h3>
                
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Companion Name</label>
                <div className="flex space-x-2">
                    <input
                        type="text"
                        value={localName}
                        onChange={(e) => setLocalName(e.target.value)}
                        placeholder="e.g., Oracle, Sentinel, Aura"
                        className={`flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:ring-4 ${getAccentClass(500, 'focus:ring')} ${getAccentClass(500, 'focus:border')}`}
                    />
                     <button
                        onClick={handleNameSave}
                        disabled={isLoading || !localName.trim()}
                        className={`p-3 ${getAccentClass(600, 'bg')} text-white font-bold rounded-xl hover:${getAccentClass(700, 'bg')} transition duration-300 disabled:bg-gray-400`}
                    >
                        Save
                    </button>
                </div>
                
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300">Avatar Style & Color</label>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
                    {Object.keys(AVATAR_COLOR_MAP).map((style) => {
                        const config = AVATAR_COLOR_MAP[style];
                        const buttonAccentClass = `border-${config.color}-500`;
                        const buttonBgClass = `bg-${config.color}-50`;
                        
                        // New logic for passing the current name on avatar change
                        const handleAvatarChange = () => {
                            handleSaveConfig(style, config.color, companionName);
                        };

                        return (
                            <button
                                key={style}
                                onClick={handleAvatarChange} // Calls save function on click
                                className={`p-3 rounded-xl transition-all duration-200 border-2 flex flex-col items-center ${
                                    avatarStyle === style
                                        ? `${buttonAccentClass} ${buttonBgClass} dark:bg-${config.color}-900 ring-4 ring-${config.color}-200`
                                        : 'border-gray-200 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700'
                                }`}
                            >
                                {getAvatar(style)}
                                <span className="text-xs font-medium mt-1 dark:text-gray-300">{config.name} ({style})</span>
                            </button>
                        );
                    })}
                </div>
                
                <div className="pt-4">
                    <p className="text-sm text-gray-500 dark:text-gray-400">Selecting an avatar immediately saves the settings and changes the app's accent color.</p>
                </div>
            </div>
        );
    };


    // --- MAIN RENDER ---
    return (
        <div className={`min-h-screen ${isDarkMode ? 'dark bg-gray-900 text-gray-100' : 'bg-gray-50 text-gray-800'} flex flex-col items-center p-4 font-sans`}>
            <script src="https://cdn.tailwindcss.com"></script>
            <style>{`
                @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&display=swap');
                .font-sans { font-family: 'Inter', sans-serif; }
                .card {
                    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
                }
                .dark .card {
                    box-shadow: 0 5px 15px rgba(255, 255, 255, 0.05);
                }
                /* Custom style to inject the dynamic color into the range slider thumb */
                input[type=range]::-webkit-slider-thumb {
                    -webkit-appearance: none;
                    height: 20px;
                    width: 20px;
                    border-radius: 50%;
                    /* Dynamic color injection */
                    background: var(--primary-color); 
                    cursor: pointer;
                    margin-top: -3px; 
                }
                input[type=range]:focus::-webkit-slider-thumb {
                    box-shadow: 0 0 0 4px var(--primary-color-ring);
                }
            `}</style>
            
            {/* CSS Variables for Dynamic Styling */}
            <div 
                className="max-w-xl w-full"
                style={{
                    '--primary-color': `var(--tw-color-${primaryColor}-600)`,
                    '--primary-color-ring': `var(--tw-color-${primaryColor}-200)`,
                }}
            >

                {/* HEADER */}
                <header className="py-6 text-center relative">
                    <div className="absolute top-2 right-0">
                         {/* Dark Mode Toggle */}
                        <button
                            onClick={() => setIsDarkMode(!isDarkMode)}
                            className="p-2 rounded-full text-gray-500 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors duration-200"
                            aria-label="Toggle dark mode"
                        >
                            {isDarkMode ? <Sun size={24} /> : <Moon size={24} />}
                        </button>
                    </div>

                    <div className="flex items-center justify-center space-x-3">
                        {getAvatar(avatarStyle)}
                        <h1 className={`text-3xl font-bold ${getAccentClass(700, 'text')}`}>
                            {companionName}
                        </h1>
                    </div>
                    {/* Static display to confirm current user */}
                    <p className="text-sm text-gray-500 dark:text-gray-400 mt-1">
                        AI Analyst for Overlord Joshua | ID: {userId ? userId.substring(0, 8) + '...' : "Loading"}
                    </p>
                </header>

                {/* AI MESSAGE CARD */}
                <div className={`card bg-white dark:bg-gray-800 p-5 rounded-xl border-l-4 ${getAccentClass(500, 'border')} mb-4`}>
                    <div className="flex items-center space-x-3">
                        <Brain className={getAccentClass(500, 'text')} size={20} />
                        <h2 className={`text-sm font-semibold ${getAccentClass(700, 'text')}`}>{companionName}'s Insight</h2>
                        {isLoading && <Loader2 className={`animate-spin ${getAccentClass(400, 'text')}`} size={16} />}
                    </div>
                    <div className="mt-2 text-sm text-gray-600 dark:text-gray-300" dangerouslySetInnerHTML={{ __html: sparkyMessage.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') }} />
                </div>
                
                {/* DEDICATED REPLY BOX (Conversational) */}
                <div className="card bg-white dark:bg-gray-800 p-4 rounded-xl mb-6 border border-gray-200 dark:border-gray-700 space-y-2">
                    <div className="flex items-center space-x-2">
                        <MessageSquareText size={20} className="text-gray-500 dark:text-gray-400" />
                        <p className="text-sm font-semibold text-gray-700 dark:text-gray-300">
                            Reply to {companionName}
                        </p>
                    </div>
                    <div className="flex space-x-2">
                        <input
                            type="text"
                            value={userReply}
                            onChange={(e) => setUserReply(e.target.value)}
                            onKeyPress={(e) => { if (e.key === 'Enter') handleLocalReply(); }}
                            placeholder="Ask for more details or a new idea..."
                            className={`flex-1 px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:ring-4 ${getAccentClass(500, 'focus:ring')} ${getAccentClass(500, 'focus:border')}`}
                            disabled={isLoading}
                        />
                        <button
                            onClick={handleLocalReply}
                            className={`${getAccentClass(600, 'bg')} text-white p-3 rounded-xl hover:${getAccentClass(700, 'bg')} transition duration-300 disabled:bg-gray-400`}
                            disabled={!userReply.trim() || isLoading}
                        >
                            <Send size={20} />
                        </button>
                    </div>
                     {replyStatus && (
                        <div 
                            className={`p-3 rounded-lg text-sm font-medium ${
                                replyStatus.type === 'success' 
                                    ? 'bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300' 
                                    : 'bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300'
                            }`}
                            dangerouslySetInnerHTML={{ __html: replyStatus.message.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') }}
                        />
                    )}
                </div>

                {/* TAB NAVIGATION (Focus added) */}
                <div className="flex bg-white dark:bg-gray-700 rounded-t-xl overflow-hidden shadow-md">
                    <TabButton icon={<Clock size={20}/>} label="Focus" current="focus" setActive={setActiveTab} activeTab={activeTab} isDarkMode={isDarkMode} primaryColor={primaryColor} />
                    <TabButton icon={<Smile size={20}/>} label="Mood" current="mood" setActive={setActiveTab} activeTab={activeTab} isDarkMode={isDarkMode} primaryColor={primaryColor} />
                    <TabButton icon={<Moon size={20}/>} label="Sleep" current="sleep" setActive={setActiveTab} activeTab={activeTab} isDarkMode={isDarkMode} primaryColor={primaryColor} />
                    <TabButton icon={<Utensils size={20}/>} label="Food" current="food" setActive={setActiveTab} activeTab={activeTab} isDarkMode={isDarkMode} primaryColor={primaryColor} />
                    <TabButton icon={<Zap size={20}/>} label="Activity" current="activity" setActive={setActiveTab} activeTab={activeTab} isDarkMode={isDarkMode} primaryColor={primaryColor} /> 
                    <TabButton icon={<Settings size={20}/>} label="Companion" current="settings" setActive={setActiveTab} activeTab={activeTab} isDarkMode={isDarkMode} primaryColor={primaryColor} />
                </div>

                {/* LOGGING AREA */}
                <div className="card bg-white dark:bg-gray-800 p-6 rounded-b-xl mb-6 border-t-2 border-gray-200 dark:border-gray-700">
                    {activeTab === 'focus' && <FocusTimer isLoading={isLoading} handleSubmit={handleSubmit} />}
                    {activeTab === 'mood' && <LogMood currentMood={mood} setMood={setMood} isLoading={isLoading} handleSubmit={handleSubmit} />}
                    {activeTab === 'sleep' && <LogSleep currentQuality={quality} setQuality={setQuality} isLoading={isLoading} handleSubmit={handleSubmit} />}
                    {activeTab === 'food' && <LogFood currentMealType={mealType} setMealType={setMealType} isLoading={isLoading} handleSubmit={handleSubmit} />}
                    {activeTab === 'activity' && <LogActivity currentActivityType={activityType} setActivityType={setActivityType} isLoading={isLoading} handleSubmit={handleSubmit} />} 
                    {activeTab === 'settings' && <SettingsTab 
                        companionName={companionName} 
                        setCompanionName={setCompanionName} 
                        avatarStyle={avatarStyle} 
                        handleSaveConfig={handleSaveConfig} 
                        getAvatar={getAvatar}
                        getAccentClass={getAccentClass}
                        primaryColor={primaryColor}
                    />}
                </div>

                {/* ANALYSIS AND HISTORY */}
                <div className="card bg-white dark:bg-gray-800 p-6 rounded-xl">
                    <h2 className={`text-xl font-bold mb-4 flex items-center ${getAccentClass(700, 'text')}`}>
                        <TrendingUp size={24} className="mr-2"/> Data Analysis & History
                    </h2>
                    <p className="text-sm text-gray-600 dark:text-gray-400 mb-4">
                        **Current Pattern Status:** {detectPattern()}
                    </p>
                    <ul className="space-y-3">
                        {logs.slice(0, 5).map(log => (
                            <LogItem key={log.id || log.timestamp} log={log} isDarkMode={isDarkMode} primaryColor={primaryColor} />
                        ))}
                        {logs.length === 0 && <p className="text-sm text-gray-500 dark:text-gray-400 text-center">No logs yet. Start tracking to build your data profile.</p>}
                    </ul>
                </div>

            </div>
        </div>
    );
};

// --- Helper Components ---
const TabButton = ({ icon, label, current, setActive, activeTab, isDarkMode, primaryColor }) => {
    const activeClass = `bg-${primaryColor}-600 text-white`;
    const inactiveClass = `bg-white text-gray-500 hover:bg-${primaryColor}-50 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600`;

    return (
        <button
            onClick={() => setActive(current)}
            className={`flex-1 p-3 flex flex-col items-center justify-center transition-colors duration-200 text-sm font-medium ${
                activeTab === current ? activeClass : inactiveClass
            }`}
        >
            {icon}
            <span className="mt-1 hidden sm:block">{label}</span>
        </button>
    );
};

const LogItem = ({ log, isDarkMode, primaryColor }) => {
    const time = new Date(log.timestamp).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    const date = new Date(log.timestamp).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

    let icon, summary, iconColorClass;
    const accentBorderClass = `border-${primaryColor}-200 dark:border-${primaryColor}-500`;

    switch (log.type) {
        case 'mood':
            iconColorClass = log.mood === 'stressed' ? 'text-red-500' : 'text-green-500';
            icon = <Smile size={18} className={iconColorClass} />;
            summary = `${log.mood} | Trigger: ${log.trigger}`;
            break;
        case 'sleep':
            iconColorClass = `text-blue-500`;
            icon = <Moon size={18} className={iconColorClass} />;
            summary = `${log.hours} hrs (${log.quality} quality)`;
            break;
        case 'food':
            iconColorClass = `text-orange-500`;
            icon = <Utensils size={18} className={iconColorClass} />;
            summary = `${log.mealType} | Content: ${log.content}`;
            break;
        case 'activity':
            iconColorClass = `text-indigo-500`;
            icon = <Zap size={18} className={iconColorClass} />;
            summary = `${log.activity} (${log.duration} min) | H2O: ${log.hydration} oz`;
            break;
        case 'focus': // NEW LOG TYPE
            iconColorClass = log.status === 'completed' ? `text-${primaryColor}-500` : 'text-red-500';
            icon = <Clock size={18} className={iconColorClass} />;
            summary = `${log.status.toUpperCase()} (${log.duration} min) | Task: ${log.task}`;
            break;
        default:
            iconColorClass = `text-gray-500`;
            icon = <Sliders size={18} className={iconColorClass} />;
            summary = 'Unknown log type';
    }

    return (
        <li className={`flex items-start p-3 bg-gray-50 dark:bg-gray-700 rounded-lg border-l-4 ${accentBorderClass}`}>
            <span className="mr-3 mt-1">{icon}</span>
            <div className="flex-1">
                <p className="font-semibold text-sm capitalize dark:text-gray-100">{log.type}</p>
                <p className="text-xs text-gray-700 dark:text-gray-300 truncate">{summary}</p>
            </div>
            <span className="text-xs text-gray-400 dark:text-gray-400 flex flex-col items-end">
                <span>{time}</span>
                <span>{date}</span>
            </span>
        </li>
    );
}

export default App;


